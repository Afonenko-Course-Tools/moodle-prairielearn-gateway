{
  "schemaVersion": 1,
  "publicOrigin": "https://course.example",
  "database": "/var/lib/gateway/runtime.sqlite",
  "privateKeyFile": "/run/secrets/gateway-private-key.json",
  "handoffTokenFile": "/run/secrets/gateway-handoff-token",
  "caFile": "/run/tls/ca.crt",
  "bridge": {
    "url": "http://prairielearn:3001",
    "tokenFile": "/run/secrets/platform-bridge-token"
  },
  "deliveryPath": "/native",
  "instance": "pilot",
  "pollSeconds": 15,
  "registration": {
    "issuer": "https://moodle.example",
    "clientId": "registered-client-id",
    "deploymentId": "registered-deployment-id",
    "contextId": "registered-course-context",
    "authUrl": "https://moodle.example/mod/lti/auth.php",
    "jwksUrl": "https://moodle.example/mod/lti/certs.php",
    "privateJwksUrl": null,
    "tokenUrl": "https://moodle.example/mod/lti/token.php",
    "activities": {
      "defense": {
        "kind": "defense",
        "resourceLinkId": "registered-defense-resource",
        "lineitem": "https://moodle.example/mod/lti/services.php/lineitems/registered-defense/lineitem",
        "workId": null
      },
      "numbers": {
        "kind": "lab",
        "resourceLinkId": "registered-lab-resource",
        "lineitem": "https://moodle.example/mod/lti/services.php/lineitems/registered-lab/lineitem",
        "workId": "sec-lab-numbers"
      }
    }
  },
  "flow": {"mode": "approval", "capacity": {}}
}
